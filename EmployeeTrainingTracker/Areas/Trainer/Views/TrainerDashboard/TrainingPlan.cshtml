@model List<EmployeeTrainingTracker.Models.TrainingPlanViewModel>

@{
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
}

@{
    ViewBag.Title = "Training Plan";
}

<h2>Training Plan</h2>

<table class="table table-bordered" style="margin-top:20px; background:white;">


    <thead>
        <tr style="background:#f5f5f5;">
            <th>Trainer</th>
            <th>Topic</th>
            <th>Subtopics</th>
            <th>Date</th>
            <th>Start Time</th>
            <th>End Time</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.TrainerName</td>
                    <td><strong>@item.TopicName</strong></td>
                    <td>@item.SubTopicName</td>
                    <td>@item.TrainingDate.ToString("dd-MMM-yyyy")</td>
                    <td>@item.StartTime</td>
                    <td>@item.EndTime</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center" style="padding:20px;">
                    No training plan available.
                </td>
            </tr>
        }
    </tbody>


</table>

@model List<EmployeeTrainingTracker.Models.TraineeModel>
@{
    ViewBag.Title = "Trainees";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="container">

    <h2>Trainees</h2>

    <button type="button"
            class="btn btn-primary"
            data-toggle="modal"
            data-target="#addTraineeModal">
        Add Trainee
    </button>

    <br />
    <br />

    <table class="table table-bordered">

        <tr>
            <th>Trainee Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Department</th>
            <th>Designation</th>
            <th>Joining Date</th>
            <th>Status</th>
            <th>Action</th>
        </tr>

        @foreach (var trainee in Model)
        {
            <tr>
                <td>@trainee.TraineeName</td>
                <td>@trainee.Email</td>
                <td>@trainee.Phone</td>
                <td>@trainee.Department</td>
                <td>@trainee.Designation</td>
                <td>@trainee.JoiningDate.ToString("dd-MM-yyyy")</td>

                <td>
                    @(trainee.IsActive ? "Active" : "Inactive")
                </td>

                <td>
                    <button class="btn btn-warning btn-sm btnEdit"
                            data-id="@trainee.UserID">
                        Edit
                    </button>

                    @if (trainee.IsActive)
                    {
                        <button class="btn btn-danger btn-sm btnStatus"
                                data-id="@trainee.UserID"
                                data-status="false">
                            Deactivate
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-success btn-sm btnStatus"
                                data-id="@trainee.UserID"
                                data-status="true">
                            Activate
                        </button>
                    }
                </td>
            </tr>
        }

    </table>

    @*modal pop for adding trainees *@

    <div class="modal fade" id="addTraineeModal">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h4>Add Trainee</h4>

                    <button type="button" class="close" data-dismiss="modal">
                        &times;
                    </button>
                </div>

                <div class="modal-body">

                    <div class="form-group">
                        <label>Trainee Name</label>
                        <input type="text" id="TraineeName" class="form-control" />
                        <span id="nameError" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <input type="text" id="Email" class="form-control" />
                        <span id="emailError" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Phone</label>
                        <input type="text" id="Phone" class="form-control" />
                        <span id="phoneError" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Department</label>
                        <input type="text" id="Department" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Designation</label>
                        <input type="text" id="Designation" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Joining Date</label>
                        <input type="date" id="JoiningDate" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" id="Password" class="form-control" />
                        <span id="passwordError" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Confirm Password</label>
                        <input type="password" id="ConfirmPassword" class="form-control" />
                        <span id="confirmPasswordError" class="text-danger"></span>
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            id="btnSaveTrainee"
                            class="btn btn-primary">
                        Save Trainee
                    </button>

                </div>

            </div>
        </div>

    </div>

    @*i have created this modal popup for edit *@

    <div class="modal fade" id="editTraineeModal">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h4>Edit Trainee</h4>

                    <button type="button" class="close" data-dismiss="modal">
                        &times;
                    </button>
                </div>

                <div class="modal-body">

                    <input type="hidden" id="EditUserID" />

                    <div class="form-group">
                        <label>Trainee Name</label>
                        <input type="text" id="EditTraineeName" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Phone</label>
                        <input type="text" id="EditPhone" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Department</label>
                        <input type="text" id="EditDepartment" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Designation</label>
                        <input type="text" id="EditDesignation" class="form-control" />
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            id="btnUpdateTrainee"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                </div>

            </div>
        </div>

    </div>sett

</div>

@section scripts
{
    <script src="~/Scripts/trainee.js"></script>
}
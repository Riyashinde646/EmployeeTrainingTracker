@{
    ViewBag.Title = "Training Management";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="row">

    <div class="col-md-12">

        <h2>Training Management</h2>
        <button type="button"
                id="btnAssignTraining"
                class="btn btn-primary"
                data-toggle="modal"
                data-target="#assignTrainingModal">

            <span class="glyphicon glyphicon-plus"></span>
            Assign Training

        </button>
        <hr />

        <h4>Overall Training Plan</h4>

        <div id="overallTrainingPlan">
            @Html.Partial("_OverallTrainingPlan")
        </div>

    </div>

</div>


<!-- Assign Training Modal -->

<div class="modal fade" id="assignTrainingModal" tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">
                    &times;
                </button>

                <h4 class="modal-title" id="trainingModalTitle">Assign Training</h4>
            </div>

            <div class="modal-body">

                <input type="hidden" id="scheduleId" value="0" />

                <div class="form-group">
                    <label>Trainer</label>
                    <select id="ddlTrainer" class="form-control">
                        <option value="">Select Trainer</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Topic</label>
                    <select id="ddlTopic" class="form-control">
                        <option value="">Select Topic</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Sub Topics</label>

                    <div id="subTopics">

                    </div>
                </div>

                <div class="form-group">
                    <label>Trainees</label>

                    <div id="trainees">
                    </div>
                </div>

                <div class="form-group">
                    <label>Training Date</label>
                    <input type="text" id="trainingDate" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Start Time</label>
                    <input type="text" id="startTime" class="form-control" />
                </div>

                <div class="form-group">
                    <label>End Time</label>
                    <input type="text" id="endTime" class="form-control" />
                </div>

            </div>

            <div class="modal-footer">

                <button type="button" class="btn btn-default" data-dismiss="modal">
                    Cancel
                </button>

                <button type="button" id="btnSaveTraining" class="btn btn-primary">
                    Save Training
                </button>

            </div>

        </div>

    </div>

</div>


<!-- Delete Confirmation Modal -->

<div class="modal fade" id="deleteTrainingModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">

            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">
                    &times;
                </button>

                <h4 class="modal-title">Delete Training</h4>
            </div>

            <div class="modal-body">
                <p>Are you sure you want to delete this training?</p>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-default"
                        data-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-danger"
                        id="btnConfirmDelete">
                    Delete
                </button>
            </div>

        </div>
    </div>
</div>

<style>
    .xdsoft_datetimepicker {
        z-index: 99999 !important;
    }
</style>

<style>
    #trainingGrid td {
        white-space: normal !important;
        word-wrap: break-word;
    }
</style>
@section scripts
{
    <script>
        console.log("Before Training.js:", typeof $);
    </script>

    <script src="~/Scripts/Training.js"></script>
}
@model List<EmployeeTrainingTracker.Models.TrainerModel>
@{
    ViewBag.Title = "Trainers";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="container">

    <h2>Trainers</h2>

    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#addTrainerModal">
        Add Trainer
    </button>

    <br />
    <br />

    <table class="table table-bordered">

        <tr>
            <th>Trainer Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Status</th>
            <th>Action</th>
        </tr>

        @foreach (var trainer in Model)
        {
            <tr>
                <td>@trainer.TrainerName</td>
                <td>@trainer.Email</td>
                <td>@trainer.Phone</td>

                <td>
                    @(trainer.IsActive ? "Active" : "Inactive")
                </td>

                <td>
                    <button class="btn btn-warning btn-sm btnEdit"
                            data-id="@trainer.UserID">
                        Edit
                    </button>

                    @if (trainer.IsActive)
                    {
                        <button class="btn btn-danger btn-sm btnStatus"
                                data-id="@trainer.UserID"
                                data-status="false">
                            Deactivate
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-success btn-sm btnStatus"
                                data-id="@trainer.UserID"
                                data-status="true">
                            Activate
                        </button>
                    }
                </td>
            </tr>
        }

    </table>

    @*edit trainer modal popup*@

    <div class="modal fade" id="editTrainerModal" tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">
                    <h4>Edit Trainer</h4>
                </div>

                <div class="modal-body">

                    <input type="hidden" id="EditUserID" />

                    <div class="form-group">
                        <label>Trainer Name</label>
                        <input type="text" id="EditTrainerName" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <input type="text" id="EditEmail" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Phone</label>
                        <input type="text" id="EditPhone" class="form-control" />
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            id="btnUpdateTrainer"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                </div>

            </div>

        </div>

    </div>

    @*add trainer modal popup*@

    <div class="modal fade" id="addTrainerModal" tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">
                    <h4 class="modal-title">Add Trainer</h4>

                    <button type="button" class="close" data-dismiss="modal">
                        &times;
                    </button>
                </div>

                <div class="modal-body">

                    <div class="form-group">
                        <label>Trainer Name</label>
                        <input type="text" id="TrainerName" class="form-control" />
                        <span id="nameError" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <input type="text" id="Email" class="form-control" />
                        <span id="emailError" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Phone</label>
                        <input type="text" id="Phone" class="form-control" />
                        <span id="phoneError" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" id="Password" class="form-control" />
                        <span id="passwordError" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Confirm Password</label>
                        <input type="password" id="ConfirmPassword" class="form-control" />
                        <span id="confirmPasswordError" class="text-danger"></span>
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button" id="btnSaveTrainer" class="btn btn-primary">
                        Save Trainer
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

@section scripts
{
    <script src="~/Scripts/trainer.js"></script>
}
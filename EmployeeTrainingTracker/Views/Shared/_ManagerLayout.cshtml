<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - Employee Training Tracker</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link href="~/Content/jquery.datetimepicker.css" rel="stylesheet" />

    <style>

        body {
            background-color: #f5f5f5;
        }

        .sidebar {
            background-color: #2c3e50;
            min-height: 100vh;
            padding: 20px 10px;
        }

            .sidebar h4 {
                color: white;
                text-align: center;
                margin-bottom: 25px;
            }

            .sidebar a {
                display: block;
                color: white;
                padding: 10px 15px;
                margin-bottom: 5px;
                text-decoration: none;
                border-radius: 4px;
            }

                .sidebar a:hover {
                    background-color: #34495e;
                }

            .sidebar .active {
                background-color: #337ab7;
            }

        .content {
            padding: 25px;
        }
    </style>

</head>

<body>

    <div class="row">

        <!-- Sidebar -->

        <div class="col-md-2 sidebar">

            <h4>Manager Panel</h4>

            <a href="@Url.Action("Index", "Manager")"
               class="@(ViewContext.RouteData.Values["controller"].ToString() == "Manager" ? "active" : "")">
                <span class="glyphicon glyphicon-dashboard"></span>
                Dashboard
            </a>

            <a href="@Url.Action("Index", "Trainee")"
               class="@(ViewContext.RouteData.Values["controller"].ToString() == "Trainee" ? "active" : "")">
                <span class="glyphicon glyphicon-user"></span>
                Trainees
            </a>

            <a href="@Url.Action("Index", "Trainer")"
               class="@(ViewContext.RouteData.Values["controller"].ToString() == "Trainer" ? "active" : "")">
                <span class="glyphicon glyphicon-education"></span>
                Trainers
            </a>

            <a href="@Url.Action("Index", "Training")"
               class="@(ViewContext.RouteData.Values["controller"].ToString() == "Training" ? "active" : "")">
                <span class="glyphicon glyphicon-book"></span>
                Training
            </a>

            <a href="@Url.Action("Index", "Assessment")"
               class="@(ViewContext.RouteData.Values["controller"].ToString() == "Assessment" ? "active" : "")">
                <span class="glyphicon glyphicon-list-alt"></span>
                Assessments
            </a>

            <a href="@Url.Action("Index", "Report")"
               class="@(ViewContext.RouteData.Values["controller"].ToString() == "Report" ? "active" : "")">
                <span class="glyphicon glyphicon-stats"></span>
                Reports
            </a>

            <br />

            <a href="@Url.Action("Logout", "Login")">
                <span class="glyphicon glyphicon-log-out"></span>
                Logout
            </a>

        </div>


        <!-- Main Content -->

        <div class="col-md-10 content">

            @RenderBody()

        </div>

    </div>


    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")


    <!-- jqGrid -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/free-jqgrid@4.15.5/css/ui.jqgrid.min.css" />

    <script src="https://cdn.jsdelivr.net/npm/free-jqgrid@4.15.5/js/jquery.jqgrid.min.js"></script>


    <!-- jQuery UI -->

    <link rel="stylesheet"
          href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css" />

    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>


    <!-- Timepicker -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/jquery-ui-timepicker-addon/1.6.3/jquery-ui-timepicker-addon.min.css" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-ui-timepicker-addon/1.6.3/jquery-ui-timepicker-addon.min.js"></script>


    @RenderSection("scripts", required: false)

</body>
</html>